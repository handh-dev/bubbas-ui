{
  "name": "@bubbasfw/ui",
  "version": "0.3.0",
  "description": "Bubba’s universal React Native and web design system, styled with NativeWind.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      },
      "default": "./dist/tokens.js"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json",
    "./foundations": "./foundations/foundations.json",
    "./foundation-manifest": "./foundations/manifest.json",
    "./foundation-lock": "./foundations.lock.json",
    "./foundations.css": "./foundations/foundations.css"
  },
  "files": [
    "dist",
    "src",
    "tailwind-preset.cjs",
    "README.md",
    "LICENSE",
    "foundations",
    "foundations.lock.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/handh-dev/bubbas-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://handh-dev.github.io/bubbas-ui/",
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "nextjs",
    "nativewind",
    "design-system",
    "bubbas"
  ],
  "scripts": {
    "build": "node ../../scripts/foundations.mjs --check && tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "^0.21.4",
    "nativewind": "^4.2.7",
    "tailwindcss": "^3.4.17"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  },
  "bubba": {
    "systemVersion": "0.4.0",
    "brandRelease": "1.0.0",
    "foundationDigest": "87bd2d88507662443d7cc12a63b7c98c5cef6bfc53f43c5c4bc52fd9d65bf18f",
    "sourceCommit": "78cb5bd276378e3da138a815859d5948aa4f7a98"
  }
}
