{
  "name": "@bubbasfw/ui",
  "version": "0.5.0",
  "description": "Bubba\u2019s universal React Native and web design system, styled with NativeWind.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      },
      "default": "./dist/tokens.js"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json",
    "./foundations": "./foundations/foundations.json",
    "./foundation-manifest": "./foundations/manifest.json",
    "./foundation-lock": "./foundations.lock.json",
    "./foundations.css": "./foundations/foundations.css",
    "./web": {
      "browser": {
        "import": {
          "types": "./dist/web.d.ts",
          "default": "./dist/web.browser.js"
        },
        "require": {
          "types": "./dist/web.d.cts",
          "default": "./dist/web.browser.cjs"
        }
      },
      "import": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "require": {
        "types": "./dist/web.d.cts",
        "default": "./dist/web.cjs"
      }
    },
    "./web.css": "./dist/web.css",
    "./web-primitives": {
      "browser": {
        "import": "./dist/web-native.browser.js",
        "require": "./dist/web-native.browser.cjs"
      },
      "import": "./dist/web-native.js",
      "require": "./dist/web-native.cjs"
    },
    "./web-runtime": {
      "browser": {
        "import": "./dist/web-runtime.browser.js",
        "require": "./dist/web-runtime.browser.cjs"
      },
      "import": "./dist/web-runtime.js",
      "require": "./dist/web-runtime.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "tailwind-preset.cjs",
    "README.md",
    "LICENSE",
    "foundations",
    "foundations.lock.json",
    "web"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/handh-dev/bubbas-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://handh-dev.github.io/bubbas-ui/",
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "nextjs",
    "nativewind",
    "design-system",
    "bubbas"
  ],
  "scripts": {
    "build": "node ../../scripts/foundations.mjs --check && tsup && node ../../scripts/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "^0.21.4",
    "nativewind": "^4.2.7",
    "tailwindcss": "^3.4.17",
    "react-native-css-interop": "^0.2.7"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  },
  "bubba": {
    "systemVersion": "0.5.0",
    "brandRelease": "1.0.0",
    "foundationDigest": "6519085b9a56c315f7f2994f562ed6c0d7c0d260f05c687cd47f38020a37cd77",
    "sourceCommit": "31be2db4c6626f5a48d871d6a7a27bac8b7a04b9"
  }
}
