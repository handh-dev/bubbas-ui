{
  "name": "@bubbasfw/ui",
  "version": "0.1.0",
  "description": "Bubba\u2019s universal React Native and web design system, styled with NativeWind.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      },
      "default": "./dist/tokens.js"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tailwind-preset.cjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/handh-dev/bubbas-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/handh-dev/bubbas-ui#readme",
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "nextjs",
    "nativewind",
    "design-system",
    "bubbas"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "^0.21.4",
    "nativewind": "^4.2.7",
    "tailwindcss": "^3.4.17"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  }
}
